# β axis: PINNED to 1.0 (pure extrinsic — Q_I trained on r_ext only).
#
# β ≡ 1 across training and evaluation. The intrinsic critic's TD reward
# becomes pure r_ext · extrinsic_reward_multiplier; the intrinsic-reward
# branch (E3B / NGU / RND / rldp_error) is silenced architecturally
# because (1 - β) = 0. Combined with alpha/pinned_intrinsic, this
# collapses TDJepa into AMAGO actor-critic over Q_I on extrinsic rewards.
#
# Extrinsic encoder IS constructed (beta_dist.max_value > 0), so the
# extrinsic-reward context branch into the actor input is active. Same
# 2-layer 256-d transformer defaults as beta/varying.gin.
#
# Scopes (beta/, beta_val/) keep ConstantAlpha.value bindings independent
# from alpha/*.gin counterparts.

import metabfm.rl.zero_shot_rl
import metabfm.rl.extrinsic_encoder
import amago.nets.traj_encoders
import amago.nets.transformer

TDJepa.beta_dist = @beta/ConstantAlpha()
beta/ConstantAlpha.value = 1.0

TDJepa.n_betas = 1

TDJepa.val_beta_schedule = @beta_val/ConstantSchedule()
beta_val/ConstantSchedule.dist = @beta_val/ConstantAlpha()
beta_val/ConstantAlpha.value = 1.0

TDJepa.extrinsic_reward_multiplier = 1.0
TDJepa.extrinsic_tstep_encoder_type = @ExtrinsicTstepEncoder
TDJepa.extrinsic_traj_encoder_type = @extrinsic/TformerTrajEncoder

ExtrinsicTstepEncoder.tstep_dim = 128
ExtrinsicTstepEncoder.n_layers = 1
ExtrinsicTstepEncoder.d_hidden = 128

extrinsic/TformerTrajEncoder.d_model = 256
extrinsic/TformerTrajEncoder.n_layers = 2
extrinsic/TformerTrajEncoder.n_heads = 4
extrinsic/TformerTrajEncoder.pos_emb = "rope"
